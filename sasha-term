#!/usr/bin/env bash
# Chat pane: run hermes in a loop (`--cli`, else `chat`), never falling through to a shell.
# window-size latest keeps mixed-size browser clients from leaving redraw artifacts.
if [ -n "${TMUX:-}" ]; then
  tmux set-option status off 2>/dev/null
  tmux set-option window-size latest 2>/dev/null
fi
while true; do
  bash -lc 'hermes --cli || hermes chat'
  stty sane 2>/dev/null || true
  clear 2>/dev/null || true
  echo
  echo "   Sasha is resting for a moment. I'll wake her back up in a few seconds…"
  echo
  echo "   (If this message keeps coming back, tell the person who set me up.)"
  sleep 6
done
